# ═══════════════════════════════════════════════════════════════════
# blodd_answer_piper 环境变量示例
# 使用：复制为 .env 并按需取消注释；全部变量均可省略（服务有默认值）
# 注意：.env 已被 .gitignore 排除，API Key 绝不入库
# ═══════════════════════════════════════════════════════════════════

# FAQ 知识库路径（默认 data/blood_pressure_expanded/faq_extended.json）
# BP_KB=/app/data/blood_pressure_expanded/faq_extended.json

# 低置信拦截阈值（默认 0.82：综合置信度低于该值不直接作答，
# 推入待标注队列走主动学习闭环）
# BP_THRESHOLD=0.82

# 在线检索返回候选条数（默认 3）
# BP_TOP_K=3

# BERT 基座目录（默认本机训练路径；容器部署时指向挂载目录。
# 优先级：环境变量 > checkpoint 内记录的路径）
# BP_BERT_PATH=/models/bert-base-chinese

# DeepSeek API Key（LLM 数据合成用；不配置自动降级离线模板合成，
# 在线服务完全不受影响）
# DEEPSEEK_API_KEY=sk-xxxxxxxx

# 请求限流：每分钟每 IP 请求上限（默认 60；设 0 关闭限流，
# /health 探针端点豁免不受限）
# RATE_LIMIT_RPM=60

# ── P4 平台安全 ──────────────────────────────────────────
# 普通业务 Key（逗号分隔多个）：配置后所有端点（豁免 /health、/metrics、/ 外）
# 必须携带请求头 X-API-Key 才能访问；两级 Key 均未配置 = 本地开发模式全放行
# （仅记一条 warning，生产环境务必配置）
# BP_API_KEYS=user-key-001,user-key-002

# 管理 Key（逗号分隔多个）：隐含普通权限，额外可调用管理端点（标注流转
# POST /annotations/{rid}、迭代落地 POST /iterate/apply、灰度转正
# POST /admin/promote、索引刷新 POST /admin/refresh）；普通 Key 调用返回 403
# BP_ADMIN_KEYS=admin-key-001

# 管理操作审计日志路径（JSONL 追加写、只增不改；每行含
# ts/actor/action/target/detail/request_id 六字段，actor 为 Key 的
# SHA-256 前 8 位指纹，不落明文）
# BP_AUDIT_PATH=logs/audit.jsonl

# 日志级别（默认 INFO；排障时可降为 DEBUG 看检索中间过程）
# BP_LOG_LEVEL=INFO

# 日志输出格式（默认 json：结构化行式，Docker/Loki 等采集器可直接解析；
# 本地调试可切 text 人读格式）
# BP_LOG_FORMAT=json

# Windows OpenMP 冲突规避（torch/onnxruntime/scikit-learn 各带一份 OpenMP
# 会访问违例）：代码内已 os.environ.setdefault 自动设置，通常无需手动配置
# KMP_DUPLICATE_LIB_OK=TRUE
